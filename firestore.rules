rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validTask(data) {
      return data.keys().hasAll(['title', 'subject', 'dueDate', 'priority', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'subject', 'dueDate', 'priority', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 60
        && data.notes is string && data.notes.size() <= 1000
        && data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.priority in ['normal', 'alta']
        && data.status in ['pendiente', 'en-curso', 'entregada']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && validTask(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid) && validTask(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
